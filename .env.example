# =============================================================================
# Checklist del Nginx del HOST (fuera de este repo, delante de Cloudflare)
# =============================================================================
# Este .env solo configura docker-compose (postgres/backend/frontend). El
# Nginx del sistema operativo del VPS, el que recibe tráfico de Cloudflare,
# vive fuera de este repo. Verifica que tenga:
#   - proxy_pass http://127.0.0.1:8080;   (el puerto del contenedor frontend,
#     ahora restringido a localhost — ver docker-compose.yml)
#   - proxy_read_timeout / proxy_send_timeout >= 95s (igual que
#     frontend/nginx.conf y backend/src/main.ts — no lo desalinees)
#   - client_max_body_size >= 60m (subida de facturas con varias imágenes)
#   - proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     (necesarios para que `trust proxy` en backend/src/main.ts reciba la IP
#     real del visitante en vez de una IP interna de docker)
# =============================================================================

POSTGRES_DB=expensly
POSTGRES_USER=expensly
POSTGRES_PASSWORD=change-me

# URL pública desde la que un usuario abre el frontend en SU navegador
# (se usa para armar los links de los correos de invitación y recuperación
# de contraseña). NUNCA uses "localhost" en producción: ese valor solo
# funciona si el propio servidor es quien abre el link, no un usuario real
# desde su computadora. En el VPS, usa la IP pública o el dominio, ej.:
#   FRONTEND_URL=http://203.0.113.10:8080
#   FRONTEND_URL=https://expensly.midominio.com
FRONTEND_URL=http://localhost:4200
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRATION=1d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=

# Azure OpenAI (extracción de datos de facturas vía LLM). Las 5 son
# obligatorias: si falta alguna, el backend no arranca (crash-loop).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_TEXT=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4o

BREVO_USER=
BREVO_PASS=
MAIL_FROM=
MAIL_USER=
MAIL_PASS=

# Paguelo Fácil (cobro de suscripciones SaaS). PAGUELO_ENV controla si se usa
# el sandbox de pruebas o el ambiente real de cobros — confirma cuál
# corresponde antes de ir a producción.
PAGUELO_CCLW=
PAGUELO_ACCESS_TOKEN=
PAGUELO_ENV=sandbox