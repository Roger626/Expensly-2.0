# =============================================================================
# Expensly 2.0 — Backend .env example
# =============================================================================
# Copy this file to `.env` and replace placeholder values with real credentials.
#   cp backend/.env.example backend/.env
# NEVER commit your real `.env` — it is gitignored. Only this example is shared.
# =============================================================================

# --- Database (PostgreSQL) ---
# Local Docker (matches the team's standard password):
DATABASE_URL="postgresql://postgres:postgressql@localhost:5432/expensly?schema=public"
# Production (Supabase pooler) — uncomment when deploying:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DATABASE_RENDER_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"

# --- JWT auth ---
# Generate a 64-char hex secret: `openssl rand -hex 32` or any random string
JWT_SECRET="replace-with-a-64-char-random-hex-secret"
JWT_EXPIRATION="1d"

# --- Cloudinary (image uploads for facturas) ---
# Dashboard: cloudinary.com → Console → Account Details
CLOUDINARY_CLOUD_NAME="replace-cloud-name"
CLOUDINARY_API_KEY="replace-api-key"
CLOUDINARY_API_SECRET="replace-api-secret"

# --- Azure Document Intelligence (OCR fallback when QR is missing) ---
# Portal: portal.azure.com → create "Document Intelligence" resource
AZURE_OCR_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
AZURE_OCR_KEY="replace-azure-ocr-key"

# --- Azure OpenAI (structured extraction of invoice/receipt data via LLM) ---
# Portal: portal.azure.com → create "Azure OpenAI" resource → deploy a
# gpt-4o-mini model (text extraction) and a gpt-4o model (vision fallback).
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_KEY="replace-azure-openai-key"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT_TEXT="gpt-4o-mini"
AZURE_OPENAI_DEPLOYMENT_VISION="gpt-4o"

# --- Frontend URL (used for CORS allowlist + email links) ---
# Local dev:
FRONTEND_URL="http://localhost:4200"
# Production:
# FRONTEND_URL="https://expensly-app.vercel.app"

# --- Brevo SMTP (transactional email: invite, password reset, dunning) ---
# Brevo Dashboard → SMTP & API → Generate a new SMTP key
BREVO_USER="replace-brevo-smtp-username"
BREVO_PASS="replace-brevo-smtp-key"
MAIL_FROM="Expensly <noreply@example.com>"

# Optional: Gmail SMTP fallback (Brevo recommended for cloud deploys)
# MAIL_USER="you@gmail.com"
# MAIL_PASS="16-char-app-password"

# =============================================================================
# Paguelo Fácil (SaaS subscription billing — sandbox demo)
# =============================================================================
# Sign up at https://demo.paguelofacil.com → Mi Empresas → Llaves
# Each environment (sandbox vs prod) has its own CCLW + accessToken. Do NOT mix.
PAGUELO_CCLW="replace-with-sandbox-cclw"
PAGUELO_ACCESS_TOKEN="replace-with-sandbox-access-token"
PAGUELO_ENV="sandbox"
# Switch to "prod" only when deploying to production with prod credentials.

# --- Optional: backend port (defaults to 3000) ---
# PORT=3000
